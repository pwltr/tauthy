{
  "identifier": "migrated",
  "description": "permissions that were migrated from v1",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "clipboard-manager:allow-write-text",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": ["$DATA/**"]
    },
    "os:allow-os-type",
    "process:allow-restart",
    "shell:allow-open",
    "updater:default"
  ]
}
